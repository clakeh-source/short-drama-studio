# ---------------------------------------------------------------------------
# Short Drama Studio — environment
# Copy to .env.local and fill in. NOTHING with a provider key may ever be
# prefixed NEXT_PUBLIC_.
#
# THIS FILE IS COMMITTED — it is the one env file .gitignore does not cover.
# Leave every secret empty here and put real values in .env.local. Both rules are
# enforced by `pnpm check:secrets`, which runs during build.
# ---------------------------------------------------------------------------

# --- App ------------------------------------------------------------------
# Absolute origin of this deployment. Used to build magic-link redirects.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase -------------------------------------------------------------
# Project URL, e.g. https://abcdefgh.supabase.co  (Dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key. Safe for the browser: RLS is what protects the data.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Secret service-role key. Server-only. Bypasses RLS — never expose to a client.
SUPABASE_SERVICE_ROLE_KEY=
# Pooled Postgres connection string (Dashboard → Connect → Transaction pooler).
# Drizzle uses this. Queries for user data run inside a `set local role authenticated`
# transaction so RLS applies (see lib/db/rls.ts).
DATABASE_URL=

# --- Storage buckets ------------------------------------------------------
# Created by `pnpm db:buckets`. Override only if you renamed them.
#
# Supabase Storage is S3-compatible and is this project's object store; there is
# no separate set of S3_* credentials. The bucket names below plus
# SUPABASE_SERVICE_ROLE_KEY are the whole storage configuration, and everything
# goes through the StorageProvider interface in lib/storage.ts, so swapping in
# raw S3 later is one adapter file.
SUPABASE_BUCKET_CLIPS=clips
SUPABASE_BUCKET_AUDIO=audio
SUPABASE_BUCKET_RENDERS=renders
# Character reference stills. The only bucket a browser uploads to directly.
SUPABASE_BUCKET_REFERENCES=references

# --- Anthropic (bible / script / storyboard generation) -------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Provider selection ---------------------------------------------------
# Which adapter the registry resolves. `stub` returns fake data after 2s and
# costs nothing — the default for local development and CI.
# llm:    stub | anthropic   (defaults to anthropic when ANTHROPIC_API_KEY is set)
LLM_PROVIDER=
# video:  stub | replicate | fal   (fal is Kling; see below)
VIDEO_PROVIDER=stub
# tts:    stub | elevenlabs
TTS_PROVIDER=stub
# render: stub | shotstack | ffmpeg
RENDER_PROVIDER=stub

# --- Video generation (Replicate) ----------------------------------------
# Replicate hosts the model; it does not define it. The four settings below
# describe *your chosen model*, and the defaults are only a sane starting point.
REPLICATE_API_TOKEN=
# Model slug used for shot generation, e.g. owner/name or owner/name:version.
# A bare owner/name runs whatever version is current; pin it for reproducibility.
REPLICATE_VIDEO_MODEL=
# Clip lengths the model actually accepts, comma-separated. The storyboard plans
# against this grid, so a wrong list produces wrong-length shots. Default: 5,10
REPLICATE_VIDEO_DURATIONS=
# The model's published price per second of output, in cents. Drives both the
# pre-flight estimate and the recorded charge. Default: 5
REPLICATE_VIDEO_COST_CENTS_PER_SECOND=
# Input field a reference image goes in — models call it `image`, `start_image`
# or `first_frame_image`. Default: image
REPLICATE_VIDEO_IMAGE_INPUT=
# JSON object of model-specific inputs with no place on VideoGenInput, merged
# beneath the canonical fields. e.g. {"resolution":"1080p","cfg_scale":0.5}
REPLICATE_VIDEO_EXTRA_INPUT=

# --- Video generation (fal.ai / Kling) -----------------------------------
# Secret key from fal.ai → Keys. Read only by the `fal` video adapter, which is
# registered in Phase 4; setting this now has no effect until then.
FAL_KEY=
# Defaults below are Kling v3 Pro. The adapter picks image-to-video when the
# shot's characters have canonical reference stills and text-to-video otherwise.
FAL_KLING_TEXT_TO_VIDEO_MODEL=fal-ai/kling-video/v3/pro/text-to-video
FAL_KLING_IMAGE_TO_VIDEO_MODEL=fal-ai/kling-video/v3/pro/image-to-video
# Kling's published price per second of output, in cents. Drives the pre-flight
# estimate, the spend cap and the recorded charge — fal reports no per-request
# cost, so a wrong number here misreports spend rather than failing. Default: 9
FAL_KLING_COST_CENTS_PER_SECOND=
# JSON object of Kling inputs with no place on VideoGenInput, merged beneath the
# canonical fields. e.g. {"cfg_scale":0.5}
FAL_KLING_EXTRA_INPUT=

# --- Character reference stills (fal.ai text-to-image) --------------------
# image:  stub | fal   (defaults to fal when FAL_KEY is set)
IMAGE_PROVIDER=
# Flux dev by default. These images decide what a character looks like in every
# clip of the film, so schnell's ~8x saving is a false economy — override only
# for a cheap dry run.
FAL_IMAGE_MODEL=fal-ai/flux/dev
# Published price per image, in cents. Default: 3
FAL_IMAGE_COST_CENTS=
# Identity-preserving model. The first still of a character is generated from
# the appearance prompt; every later one is generated from *its face* by this
# model, so the canonical set is one person rather than three who match the same
# description. InstantID and IP-Adapter FaceID drop in here unchanged.
FAL_IMAGE_IDENTITY_MODEL=fal-ai/flux-pulid
# Identity models run a face encoder on top of the base model. Default: 5
FAL_IMAGE_IDENTITY_COST_CENTS=
# How many faces the identity model actually reads. This DESCRIBES the model
# above — it does not grant it a capability. PuLID, InstantID and IP-Adapter
# FaceID read one face, and setting this higher against them is clamped back to
# one with a warning, because the alternative is an asset row claiming a
# two-hander was locked when the second character came from the prompt.
# Point FAL_IMAGE_IDENTITY_MODEL at a multi-identity model first, then raise
# this. Max 4. Default: 1
FAL_IMAGE_IDENTITY_CAPACITY=

# --- Shot keyframes -------------------------------------------------------
# Before filming a shot, draw its first frame: the right location and framing,
# with every character in it conditioned on their reference stills. That frame
# becomes the video model's start frame instead of a studio portrait — which is
# what makes multi-character shots hold, and stops every clip opening on a grey
# backdrop it has to travel out of. Costs one image per shot.
# `off` falls back to conditioning on the character stills. Default: on
SHOT_KEYFRAMES=

# --- TTS (ElevenLabs) -----------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_MODEL_ID=eleven_multilingual_v2
# Must stay a wav_* format: the voice upload is stored as audio/wav, and the
# duration is read from the alignment. 44.1kHz needs an ElevenLabs Pro plan.
ELEVENLABS_OUTPUT_FORMAT=wav_24000
# Cents per 1,000 characters. Plan-dependent — roughly 2.2 on Creator. Default: 3
ELEVENLABS_CENTS_PER_1K_CHARS=

# --- Render (Shotstack cloud adapter) ------------------------------------
SHOTSTACK_API_KEY=
# stage | v1
SHOTSTACK_ENV=stage

# --- Render (local ffmpeg fallback adapter) ------------------------------
# Absolute path to the ffmpeg binary. Only read when RENDER_PROVIDER=ffmpeg.
FFMPEG_PATH=/opt/homebrew/bin/ffmpeg
# How far the optional music bed sits under the dialogue, in dB. Must be <= 0 —
# it is a level *under* the voice, not an absolute one. Default: -18
MUSIC_BED_LEVEL_DB=

# --- Inngest (background jobs) -------------------------------------------
# Local dev: leave blank and run `pnpm inngest:dev`.
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# --- Unattended runs ------------------------------------------------------
# In-flight video jobs per project. 3 bounds cost and stays well inside provider
# rate limits, and it is also what decides how long a run takes: 36 clips is a
# ~24-minute wait at 3, ~9 minutes at 8. Raise it if your provider tolerates it.
VIDEO_CONCURRENCY=3
# How long a run pauses at the bible and shot-list gates before carrying on by
# itself. 0 makes runs fully unattended. Default: 120
RUN_GATE_SECONDS=

# --- Spend guard ----------------------------------------------------------
# Hard per-user monthly ceiling in cents. Generation refuses to enqueue past it.
MAX_MONTHLY_SPEND_CENTS=2000
